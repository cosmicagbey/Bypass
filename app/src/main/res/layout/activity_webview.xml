<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Bottom sheet container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom">

        <!-- Tap outside to dismiss -->
        <View
            android:id="@+id/dim_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/dim_overlay"
            android:clickable="true"
            android:focusable="true" />

        <!-- WebView sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_sheet"
            android:elevation="16dp">

            <!-- Sheet Header / Drag Handle Indicator -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/ic_drag_handle" />

            <!-- Toolbar -->
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:background="@color/surface_card">

                <!-- Close -->
                <ImageButton
                    android:id="@+id/btn_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_close"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close" />

                <!-- Platform title -->
                <TextView
                    android:id="@+id/tv_platform_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <!-- Refresh -->
                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_refresh"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh" />

                <!-- Open in full browser -->
                <ImageButton
                    android:id="@+id/btn_open_browser"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_open_in_browser"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open in browser" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <!-- WebView -->
            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
